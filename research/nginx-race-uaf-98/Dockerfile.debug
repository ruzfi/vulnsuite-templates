FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc make libc6-dev libpcre2-dev zlib1g-dev libssl-dev perl ca-certificates patch \
 && rm -rf /var/lib/apt/lists/*
COPY . /usr/src/nginx
WORKDIR /usr/src/nginx
ARG PATCHES=""
RUN for p in $PATCHES; do echo "applying $p"; patch -p1 < _patches/$p.patch || exit 1; done
RUN ./auto/configure \
      --prefix=/etc/nginx --sbin-path=/usr/sbin/nginx \
      --conf-path=/etc/nginx/nginx.conf --pid-path=/run/nginx.pid \
      --error-log-path=/var/log/nginx/error.log --http-log-path=/var/log/nginx/access.log \
      --user=nginx --group=nginx \
      --with-http_ssl_module --with-http_v2_module --with-http_v3_module \
      --with-mail --with-mail_ssl_module --with-stream --with-debug \
      --with-cc-opt='-O1 -g -fno-omit-frame-pointer -fsanitize=address -DNGX_DEBUG_PALLOC=1' \
      --with-ld-opt='-fsanitize=address' \
 && make -j"$(nproc)" \
 && make install \
 && useradd -r -U -M -s /usr/sbin/nologin nginx \
 && mkdir -p /var/log/nginx /var/cache/nginx \
 && install -d -m 1777 /var/log/asan
# FIX for the known gap: log_path in a directory the nginx worker user can write
ENV ASAN_OPTIONS=detect_leaks=0:abort_on_error=0:halt_on_error=1:log_path=/var/log/asan/asan
EXPOSE 80
STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;"]
